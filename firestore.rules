rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function hasProfile() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() { return hasProfile() && profile().active == true; }
    function isOwner()  { return isActive() && profile().role == 'owner'; }

    // ---- people ----
    match /users/{uid} {
      // you can read your own profile (even when switched off, so the app can tell you);
      // the owner can read the people who work for them
      allow read: if request.auth != null &&
        (request.auth.uid == uid || (isOwner() && resource.data.ownerUid == request.auth.uid));

      allow create: if request.auth != null && (
        // the one owner account: ONLY this email may become an owner (change it below!)
        (request.auth.uid == uid
          && request.auth.token.email in ['OWNER_EMAIL_HERE']
          && request.resource.data.role == 'owner'
          && request.resource.data.ownerUid == uid
          && request.resource.data.active == true)
        ||
        // attendants are created by the owner only
        (isOwner()
          && request.resource.data.role == 'attendant'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.active == true)
      );

      allow update: if request.auth != null && (
        // anyone can refresh their own "last seen" and nothing else
        (request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']))
        ||
        // the owner can switch an attendant on/off or rename them
        (isOwner() && resource.data.ownerUid == request.auth.uid && resource.data.role == 'attendant' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'name']))
      );
    }

    // ---- sales: each phone writes its own; the owner reads everyone's ----
    match /sales/{saleId} {
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUid == profile().ownerUid;
      allow update: if isActive()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow read: if isActive() &&
        (resource.data.uid == request.auth.uid ||
          (isOwner() && resource.data.ownerUid == request.auth.uid));
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- offers: only the owner changes them; their attendants read them ----
    match /offers/{ownerId} {
      allow read: if isActive() && profile().ownerUid == ownerId;
      allow write: if isOwner() && request.auth.uid == ownerId;
    }
  }
}
